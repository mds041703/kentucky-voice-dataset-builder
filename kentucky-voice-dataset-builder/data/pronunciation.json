    "vowel": "Words useful for monitoring general American and regional vowel characteristics.",
    "device": "Smart-home device vocabulary.",
    "location": "Smart-home room and location vocabulary.",
    "action": "Smart-home control verbs and command phrases.",
    "context": "Words used to express environmental conditions or implied requests.",
    "reference": "Pronouns and demonstratives used to refer to devices.",
    "grammar": "Articles, prepositions, and grammatical words needed for natural sentence construction.",
    "regional": "Vocabulary and constructions associated with Southern/Appalachian conversational speech.",
    "reduction": "Connected-speech reductions that should be spoken naturally rather than artificially represented in spelling.",
    "phrase": "Common multi-word conversational phrases."
  },

  "recording_guidance": {
    "transcription": "Use the standard written form of the intended words. Do not intentionally misspell words to represent an accent.",
    "speech": "Speak naturally. Do not exaggerate a Southern or Appalachian accent.",
    "variation": "Record targets in multiple natural sentence contexts whenever possible.",
    "connected_speech": "Allow natural reductions and linking between words. Do not force every word to be pronounced in isolation.",
    "regional_speech": "Regional vocabulary should occur naturally and should not be inserted into every recording.",
    "articles": "Record articles such as 'the' naturally in connected phrases. Do not omit articles from ordinary commands.",
    "prepositions": "Record location prepositions such as 'in', 'on', and 'at' naturally. Prefer complete phrases such as 'in the utility room' rather than unnatural compressed constructions such as 'utility room'.",
    "device_location": "When a device is followed by a room location, prefer natural constructions such as 'the fan in the utility room', 'the AC in the house', and 'the light in the hallway'.",
    "reference_resolution": "Record natural pronoun references such as 'it', 'that', 'them', and 'those' in complete conversational contexts.",
    "smart_home_focus": "Prioritize common smart-home words and natural command structures such as 'turn on the light', 'turn off the AC in the house', 'start the fan in the utility room', 'shut off the bedroom light in the hallway', and 'dim the porch light'.",
    "goal": "Capture natural acoustic and linguistic variation for robust smart-home speech recognition rather than teaching an artificial phonetic spelling system."
  }

{
"version": 3,
"description": "Smart-home natural-language intent dataset for Home Assistant. Designed for American English with natural Southern and Appalachian-influenced conversational variation. Supports direct commands, noun-first commands, indirect requests, contextual implications, pronoun references, deictic references, fragmented speech, filler, profanity, and multi-clause conversational commands. The wake word is handled separately from intent parsing.",

"processing": {
"wake_word": {
"enabled": true,
"example": "hobo",
"handling": "Remove the wake word before intent parsing. Do not include the wake word in the semantic intent."
},

"pipeline": [
  "wake_word_detection",
  "speech_to_text",
  "utterance_normalization",
  "intent_detection",
  "entity_resolution",
  "context_resolution",
  "action_validation",
  "home_assistant_execution"
],

"important_rule": "Natural language may omit the action, device, location, or even the explicit request. Missing information may be inferred only when context makes the intended action sufficiently clear."

},

"utterance_types": {
"direct": {
"description": "Explicit action and target.",
"examples": [
"turn on the living room lights",
"turn the living room lights on",
"turn off the bedroom light",
"lock the front door"
]
},

"noun_first": {
  "description": "Device or location appears before the requested state.",
  "examples": [
    "living room lights on",
    "kitchen lights off",
    "bedroom fan on",
    "TV off",
    "front door locked"
  ]
},

"conversational": {
  "description": "Natural request with filler, politeness, or conversational framing.",
  "examples": [
    "can you turn on the living room lights",
    "how about you turn on the lights",
    "I need you to turn off the TV",
    "go ahead and turn on the porch lights"
  ]
},

"reference": {
  "description": "The target is referenced indirectly using pronouns or deictic expressions.",
  "examples": [
    "turn them on",
    "turn that one off",
    "turn it on",
    "turn the one in the kitchen on",
    "shut that one off"
  ]
},

"regional_reference": {
  "description": "Natural Southern/Appalachian reference constructions.",
  "examples": [
    "turn them lights on",
    "turn them living room lights on",
    "cut on them lights over there",
    "turn that there light on",
    "turn this here light off"
  ]
},

"contextual": {
  "description": "A condition implies the desired action.",
  "examples": [
    "it's dark in the living room",
    "it's too damn dark in here",
    "I can't see in the bedroom",
    "it's freezing in here",
    "it's getting pretty warm in the house"
  ]
},

"multi_clause": {
  "description": "The utterance contains a contextual statement followed by an explicit or implied request.",
  "examples": [
    "it's dark in here, turn on the lights",
    "it's too damn dark in the living room, how about you turn on the lights in here",
    "I can't see in the kitchen, go ahead and cut on the lights"
  ]
},

"fragment": {
  "description": "Incomplete or compressed conversational speech.",
  "examples": [
    "living room lights",
    "the ones in here",
    "that light over there",
    "them lights",
    "lights on in here"
  ]
}

},

"intent_patterns": {

"direct": [
  "{action} {device}",
  "{action} {device} {state}",
  "{action} {device} in {location}",
  "{action} {device} in the {location}",
  "{action} the {location} {device}",
  "{action} {location} {device}",
  "{action} the {device} in the {location}",
  "{device} {action}",
  "{device} {state}",
  "{device} {location} {state}"
],

"noun_first": [
  "{device} {state}",
  "{device} {location} {state}",
  "{location} {device} {state}",
  "{device} in {location} {state}",
  "the {location} {device} {state}",
  "{location} {device} {action}",
  "{device} on",
  "{device} off"
],

"request": [
  "{opening} {action} {device}",
  "{opening} {action} {device} in {location}",
  "{opening} {action} the {location} {device}",
  "{opening}, {action} {device}",
  "{opening}, {action} {device} in {location}",
  "{opening} {device} {state}"
],

"question": [
  "{question} {action} {device}",
  "{question} {action} {device} in {location}",
  "{question} you {action} {device}",
  "{question} you {action} {device} in {location}"
],

"reference": [
  "{opening} {action} it",
  "{opening} {action} that",
  "{opening} {action} that one",
  "{opening} {action} this one",
  "{opening} {action} them",
  "{opening} {action} those",
  "{opening} {action} the one in {location}",
  "{opening} {action} that {device}",
  "{opening} {action} them {device}",
  "{opening} {action} them {device} over there"
],

"regional": [
  "{opening} {action} them {device}",
  "{opening} {action} them {device} over there",
  "{opening} {action} that there {device}",
  "{opening} {action} this here {device}",
  "{opening} go on and {action} {device}",
  "{opening} go on and {action} {device} in {location}",
  "{opening} might as well {action} {device}",
  "{opening} {action} {device} over yonder"
],

"contextual": [
  "{context}",
  "{context}, {action} {device}",
  "{context}, {opening} {action} {device}",
  "{context}, can you {action} {device}",
  "{context}, how about you {action} {device}",
  "{context}, go ahead and {action} {device}"
],

"multi_clause": [
  "{context}, {action} {device}",
  "{context}, {opening} {action} {device}",
  "{context}, how about you {action} {device}",
  "{context}, I need you to {action} {device}",
  "{context}, go ahead and {action} {device}",
  "{context}, might as well {action} {device}"
]

},

